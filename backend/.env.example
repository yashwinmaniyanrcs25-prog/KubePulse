# KubePulse Backend Configuration
KUBEPULSE_ENV=development
KUBEPULSE_PORT=8080
KUBEPULSE_HOST=0.0.0.0

# Kubernetes Cluster Configuration
# Defaults to %USERPROFILE%\.kube\config or ~/.kube/config
KUBECONFIG_PATH=
# Specific context to use if multiple contexts are defined (optional)
KUBECONFIG_CONTEXT=
TARGET_NAMESPACE=kubepulse
TARGET_DEPLOYMENT=kubepulse-sample

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
